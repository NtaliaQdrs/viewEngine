<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Agendar Partida - Arena Soccer</title>
    <link rel="stylesheet" href="/stylesheets/style.css"> </head>
<body>
    <header>
        <h1>Reserva de Horário</h1>
        <a href="/">Voltar para o Início</a>
    </header>

    <main>
        <form action="/agendar" method="POST">
            <label for="nome">Nome da Equipe:</label>
            <input type="text" id="nome" name="equipe" required>

            <label for="data">Data:</label>
            <input type="date" id="data" name="data" required>

            <label for="campo">Tipo de Campo:</label>
            <select id="campo" name="campo">
                <option value="society">Society (Sintético)</option>
                <option value="futsal">Futsal</option>
                <option value="campo-natural">Gramado Natural</option>
            </select>

            <button type="submit" class="btn-primary">Confirmar Reserva</button>
        </form>
    </main>
</body>
</html>